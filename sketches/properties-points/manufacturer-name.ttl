# -----------------------------------------------------------
# Simple statement
# -----------------------------------------------------------

:mypump1
    a                       ex:Pump                         ;
    ex:manufacturerName     "Siemens"                       .


# -----------------------------------------------------------
# Reified statement
# -----------------------------------------------------------

[]
    a                       rdf:Statement                   ;
    rdf:subject             :mypump1                        ;
    rdf:predicate           ex:manufacturerName             ;
    rdf:object              "Siemens"                       .

:mypump1
    a                       ex:Pump                         .


# -----------------------------------------------------------
# Reified property
# -----------------------------------------------------------

:mypump1
    a                       ex:Pump                         ;
    ex:hasProperty          :mypump1-manufacturername       .

:mypump1-manufacturername
    a                       ex:ManufacturerNameProperty     ;
    ex:hasValue             "Siemens"                       .


# -----------------------------------------------------------
# Reified property with an external reference
# -----------------------------------------------------------

:mypump1
    a                       ex:Pump                         ;
    ex:hasProperty          :mypump1-manufacturername       .

:mypump1-manufacturername
    a                       ex:ManufacturerNameProperty     ;
    ex:hasValueAt           "bacnet://123/45,678/90"        .


# -----------------------------------------------------------
# Reified property without a value
# -----------------------------------------------------------

:mypump1
    a                       ex:Pump                         ;
    ex:hasProperty          :mypump1-manufacturername       .

:mypump1-manufacturername
    a                       ex:ManufacturerNameProperty     .


# -----------------------------------------------------------
# Point for a property
# -----------------------------------------------------------

:mycontroller1
    a                       ex:Controller                   ;
    ex:hostsPoint           :mycontroller1-point678         .

:mycontroller1-point678
    a                       ex:Point                        ;
    ex:pointName            "B01_Flr02_Pump1_MnftrNm"       ;
    ex:hasAddress           "bacnet://123/45,678/90"        ;
    ex:providesValueOfType  xsd:string                      ;
    ex:providesValueFor     :mypump1-manufacturername       ;
    ex:readable             true                            ;
    ex:writable             true                            ;
    ex:hasLastKnownValue    "Siemens"                       .


# -----------------------------------------------------------

ex:manufacturerName
    a                       rdf:Property                    .

ex:ManufacturerNameProperty
    a                       rdfs:Class                      ;
    rdfs:subClassOf         ex:StringProperty               .

ex:StringProperty
    a                       rdfs:Class                      ;
    rdfs:subClassOf         ex:Property                     .

ex:Property
    a                       rdfs:Class                      .

ex:Point
    a                       rdfs:Class                      .
